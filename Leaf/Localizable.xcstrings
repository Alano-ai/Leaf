      }
    },
    "Leaf cannot open password-protected or encrypted PDFs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaf 无法打开受密码保护或已加密的 PDF。"
