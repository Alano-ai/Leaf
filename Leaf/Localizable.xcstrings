      }
    },
    "DeepSeek receives the format, counts, and check results shown here. Book text, images, titles, and filenames stay on this Mac. Your DeepSeek account may be charged." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek 只会收到这里显示的格式、数量和检查结果。书籍正文、图片、书名和文件名保留在此 Mac 上。你的 DeepSeek 账户可能产生费用。"
          }
        }
      }
    },
